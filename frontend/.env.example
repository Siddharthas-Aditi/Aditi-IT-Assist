# ==================================================
# Frontend — Aditi IT Assist
# ==================================================
# Vite exposes these as import.meta.env.VITE_*
# Copy to .env for local development.

# VITE_API_URL: Full API base URL with /api/v1 prefix
# Used by React app running in BROWSER (localhost, not Docker network)
# In Docker:    http://localhost:8000/api/v1 (browser accesses via host port)
# In local dev: http://localhost:8000/api/v1 (npm run dev)
VITE_API_URL=http://localhost:8000/api/v1

# VITE_API_TARGET: Backend target for Vite proxy (dev server only)
# Used by Vite dev server INSIDE Docker container
# In Docker:    http://aditi-backend:8000 (uses Docker service name)
# In local dev: http://localhost:8000 (npm run dev)
VITE_API_TARGET=http://localhost:8000

# App metadata
VITE_APP_TITLE=Aditi IT Assist         # Browser tab title

# VITE_TEAMS_WEBHOOK_URL: Microsoft Teams Incoming Webhook URL for IT escalation alerts.
# How to get: Teams → IT Support channel → ··· → Connectors → Incoming Webhook → Create
# Leave empty to disable Teams notifications (escalation banner still appears in the UI).
VITE_TEAMS_WEBHOOK_URL=
