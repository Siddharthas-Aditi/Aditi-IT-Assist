# ==================================================
# Frontend — Aditi IT Assist
# ==================================================
# Vite exposes these as import.meta.env.VITE_*
# Copy to .env for local development.

# API URL for browser fetch calls (when frontend is accessed via http://localhost:5173)
# IMPORTANT: This should include the full base URL with /api/v1
# Examples:
#   Local dev (npm run dev):  http://localhost:8000/api/v1
#   Docker dev:               http://aditi-backend:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Backend target for Vite proxy (dev server only, not used in production build)
# This is used when accessing frontend via dev server (http://localhost:5173)
# Examples:
#   Local dev:  http://localhost:8000
#   Docker dev: http://aditi-backend:8000
VITE_API_TARGET=http://localhost:8000

# App metadata
VITE_APP_TITLE=Aditi IT Assist         # Browser tab title
