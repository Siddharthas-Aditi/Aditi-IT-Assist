# ==================================================
# Aditi IT Assist — Environment Configuration
# ==================================================
# Copy this file to .env and fill in required values.
# NEVER commit .env to version control.
#
# Legend: [REQUIRED] must be set  |  [OPTIONAL] has working default

# ─── Application ────────────────────────────────
APP_NAME=aditi-it-assist
APP_ENV=development                    # development | staging | production
DEBUG=true                             # [OPTIONAL] enables debug logging + hot reload
LOG_LEVEL=DEBUG                        # [OPTIONAL] DEBUG | INFO | WARNING | ERROR

# ─── Backend Server ─────────────────────────────
BACKEND_HOST=0.0.0.0                   # [OPTIONAL] bind address
BACKEND_PORT=8000                      # [OPTIONAL] uvicorn port
SECRET_KEY=change-me-to-a-random-secret-key-in-production  # [REQUIRED in prod] >=32 chars
API_V1_PREFIX=/api/v1                  # [OPTIONAL] API path prefix
# Allowed browser origins for CORS. Defaults to localhost dev origins; in
# production this MUST be your real https origin(s) — the backend refuses to
# boot if it still contains localhost or any non-https/wildcard origin.
# CORS_ORIGINS=["https://it-assist.yourcompany.com"]

# ─── PostgreSQL (pgvector) ──────────────────────
POSTGRES_HOST=localhost                # Use "postgres" when running in Docker
POSTGRES_PORT=5432
POSTGRES_DB=aditi_assist
POSTGRES_USER=aditi
POSTGRES_PASSWORD=aditi_dev_password   # [REQUIRED] change in production

# ─── Redis ──────────────────────────────────────
REDIS_HOST=localhost                   # Use "redis" when running in Docker
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                        # [REQUIRED in prod] backend refuses to boot without it

# ─── Chat session store ─────────────────────────
# Where multi-turn chat state + ticket idempotency live.
#   memory = bounded in-process LRU (single worker; fine for dev)
#   redis  = durable + shared across workers/restarts (use for prod/multi-worker;
#            degrades to in-memory if Redis is unreachable)
CHAT_SESSION_BACKEND=memory            # [OPTIONAL] memory | redis (set redis in prod)
CHAT_SESSION_TTL_SECONDS=86400         # [OPTIONAL] idle conversation expiry (24h)

# ─── LLM Configuration ─────────────────────────
# Supported providers: openai, azure, anthropic (via LiteLLM)
LLM_PROVIDER=openai                   # [OPTIONAL] default: openai
LLM_MODEL=gpt-4o-mini                 # [OPTIONAL] model identifier
LLM_API_KEY=your-api-key-here         # [REQUIRED] get from provider dashboard
LLM_TEMPERATURE=0.3                   # [OPTIONAL] 0.0–1.0
LLM_MAX_TOKENS=4096                   # [OPTIONAL] max response tokens

# For Azure OpenAI, also set:
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# ─── Vector Store ───────────────────────────────
VECTOR_STORE_TYPE=pgvector             # [OPTIONAL] pgvector (default)

# ─── Web Research (B2) — Optional, specialist-only, off by default ──
# Governed web research: only runs for a KB-insufficient escalation (never
# for a bare "connect me with a human" request), and results are surfaced to
# the specialist handoff context, never shown directly to the employee.
FEATURE_WEB_RESEARCH=false             # [OPTIONAL] master switch, default off
WEB_SEARCH_PROVIDER=google             # [OPTIONAL] "google" | "tavily"
GOOGLE_SEARCH_API_KEY=                 # [OPTIONAL] required if provider=google
GOOGLE_SEARCH_CX=                      # [OPTIONAL] Programmable Search Engine ID (provider=google)
TAVILY_API_KEY=                        # [OPTIONAL] required if provider=tavily; free tier at https://tavily.com

# ─── Frontend ───────────────────────────────────
# Must include the /api/v1 prefix — lib/api.ts appends paths like /auth/login
# directly to this. (Docker compose already sets the full value; this line is
# for running the frontend outside Docker.)
VITE_API_URL=http://localhost:8000/api/v1  # [OPTIONAL] backend base URL incl. prefix
VITE_APP_TITLE=Aditi IT Assist         # [OPTIONAL] browser tab title
FRONTEND_PORT=5173                     # [OPTIONAL] dev server port

# ─── Observability ──────────────────────────────
METRICS_ENABLED=true                   # [OPTIONAL] Prometheus /api/v1/health/metrics
OTEL_ENABLED=false                     # [OPTIONAL] opt-in distributed tracing
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=aditi-it-assist

# ─── Email / Escalation (Optional) ─────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ESCALATION_EMAIL=it-support@aditiconsulting.com

# ─── Authentication (Enterprise) ────────────────
AUTH_PROVIDER=local                    # local | saml | oidc
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
# Local email/password auth. MUST be false in an SSO deployment (AUTH_PROVIDER
# != local) so the IdP is the only entry point — otherwise open /register and
# local /login bypass SSO. Production boot fails if this is true under SSO.
LOCAL_AUTH_ENABLED=true
# Token revocation (logout / refresh rotation) uses a Redis jti denylist.
# false = fail-open on Redis outage (recommended); true = fail-closed (401s).
TOKEN_DENYLIST_FAIL_CLOSED=false
# Number of trusted reverse proxies in front of the app. The rate limiter reads
# the client IP as the Nth-from-right X-Forwarded-For hop (our nginx appends the
# real client), so a spoofed left-hand value can't rotate the brute-force bucket.
# Set 0 if the app is exposed directly with no proxy.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# ─── SAML SSO (Future) ─────────────────────────
# Enable when integrating with Entra ID, Okta, etc.
SAML_ENABLED=false
# SAML_IDP_ENTITY_ID=https://login.microsoftonline.com/{tenant}/
# SAML_IDP_SSO_URL=https://login.microsoftonline.com/{tenant}/saml2
# SAML_IDP_CERTIFICATE=<base64 cert>
SAML_SP_ENTITY_ID=aditi-it-assist
# SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/saml/acs
SAML_DEFAULT_ROLE=employee

# ─── Remote Support ────────────────────────────
# ADR: docs/architecture/remote-support-decision.md
REMOTE_SUPPORT_PROVIDER=microsoft_remote_help
REMOTE_SESSION_TIMEOUT_MINUTES=30
REMOTE_SESSION_MAX_DURATION_MINUTES=120
# Mock provider for dev/staging (mirrors MCP_USE_MOCK). Set false in
# production once the Graph app registration below is configured —
# production refuses to boot with mock=false and missing credentials.
REMOTE_SUPPORT_USE_MOCK=true
# Graph app registration (application perms: DeviceManagementConfiguration.Read.All,
# DeviceManagementManagedDevices.Read.All). Secret comes from the secrets manager.
REMOTE_HELP_TENANT_ID=
REMOTE_HELP_CLIENT_ID=
REMOTE_HELP_CLIENT_SECRET=
# INTUNE_ADMIN_CENTER_BASE_URL=https://intune.microsoft.com
# Background sweeper: expires lapsed consent windows, terminates over-duration sessions.
REMOTE_SESSION_SWEEPER_ENABLED=true
REMOTE_SESSION_SWEEPER_INTERVAL_SECONDS=60

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10 # tighter budget for login/refresh/register

# ── Agentic platform feature flags (Phases 5–8) — local testing defaults ──
# All default OFF in code; enabled here for local dev. See
# docs/development/agentic-local-testing.md for what each one exercises.
FEATURE_AGENT_TOOLS=true
FEATURE_VECTOR_RETRIEVAL=true
FEATURE_MCP_TOOLS=true
MCP_ENABLED_SERVERS=["msgraph","servicenow","msgraph_intune_exec"]
MCP_USE_MOCK=true
FEATURE_AGENT_WRITE_ACTIONS=true
FEATURE_BACKGROUND_AGENTS=true

# ── Device execution (Phase 9) — autonomous, catalog-bound Intune actions ──
# FEATURE_DEVICE_EXECUTION builds the install/remediation/device-action tools;
# requires msgraph_intune_exec in MCP_ENABLED_SERVERS. DEVICE_EXECUTION_AUTONOMOUS
# is the kill-switch: OFF ⇒ every action routes to human approval. _MEDIUM opts
# medium-risk catalog actions into autonomy (high-risk is never autonomous).
# See docs/architecture/device-execution-decision.md.
FEATURE_DEVICE_EXECUTION=true
DEVICE_EXECUTION_AUTONOMOUS=true
DEVICE_EXECUTION_AUTONOMOUS_MEDIUM=false
