# ==================================================
# Aditi IT Assist — Environment Configuration
# ==================================================
# Copy this file to .env and fill in required values.
# NEVER commit .env to version control.
#
# Legend: [REQUIRED] must be set  |  [OPTIONAL] has working default

# ─── Application ────────────────────────────────
APP_NAME=aditi-it-assist
APP_ENV=development                    # development | staging | production
DEBUG=true                             # [OPTIONAL] enables debug logging + hot reload
LOG_LEVEL=DEBUG                        # [OPTIONAL] DEBUG | INFO | WARNING | ERROR

# ─── Backend Server ─────────────────────────────
BACKEND_HOST=0.0.0.0                   # [OPTIONAL] bind address
BACKEND_PORT=8000                      # [OPTIONAL] uvicorn port
SECRET_KEY=change-me-to-a-random-secret-key-in-production  # [REQUIRED in prod]
API_V1_PREFIX=/api/v1                  # [OPTIONAL] API path prefix

# ─── PostgreSQL (pgvector) ──────────────────────
POSTGRES_HOST=localhost                # Use "postgres" when running in Docker
POSTGRES_PORT=5432
POSTGRES_DB=aditi_assist
POSTGRES_USER=aditi
POSTGRES_PASSWORD=aditi_dev_password   # [REQUIRED] change in production

# ─── Redis ──────────────────────────────────────
REDIS_HOST=localhost                   # Use "redis" when running in Docker
REDIS_PORT=6379
REDIS_DB=0

# ─── LLM Configuration ─────────────────────────
# Supported providers: openai, azure, anthropic (via LiteLLM)
LLM_PROVIDER=openai                   # [OPTIONAL] default: openai
LLM_MODEL=gpt-4o-mini                 # [OPTIONAL] model identifier
LLM_API_KEY=your-api-key-here         # [REQUIRED] get from provider dashboard
LLM_TEMPERATURE=0.3                   # [OPTIONAL] 0.0–1.0
LLM_MAX_TOKENS=4096                   # [OPTIONAL] max response tokens

# For Azure OpenAI, also set:
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# ─── Vector Store ───────────────────────────────
VECTOR_STORE_TYPE=pgvector             # [OPTIONAL] pgvector (default)

# ─── Web Search Fallback (Optional) ──────────────
# When KB has no guidance, fallback to web search (requires Tavily API key)
# Get free API key at: https://tavily.com (free tier: 1000 calls/month)
TAVILY_API_KEY=                        # [OPTIONAL] leave empty to disable web search

# ─── Frontend ───────────────────────────────────
VITE_API_URL=http://localhost:8000     # [OPTIONAL] backend URL for frontend
VITE_APP_TITLE=Aditi IT Assist         # [OPTIONAL] browser tab title
FRONTEND_PORT=5173                     # [OPTIONAL] dev server port

# ─── Observability (Optional) ───────────────────
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=aditi-it-assist

# ─── Email / Escalation (Optional) ─────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ESCALATION_EMAIL=it-support@aditiconsulting.com

# ─── Authentication (Enterprise) ────────────────
AUTH_PROVIDER=local                    # local | saml | oidc
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ─── SAML SSO (Future) ─────────────────────────
# Enable when integrating with Entra ID, Okta, etc.
SAML_ENABLED=false
# SAML_IDP_ENTITY_ID=https://login.microsoftonline.com/{tenant}/
# SAML_IDP_SSO_URL=https://login.microsoftonline.com/{tenant}/saml2
# SAML_IDP_CERTIFICATE=<base64 cert>
SAML_SP_ENTITY_ID=aditi-it-assist
# SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/saml/acs
SAML_DEFAULT_ROLE=employee

# ─── Remote Support ────────────────────────────
REMOTE_SUPPORT_PROVIDER=microsoft_remote_help
REMOTE_SESSION_TIMEOUT_MINUTES=30
REMOTE_SESSION_MAX_DURATION_MINUTES=120

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Agentic platform feature flags (Phases 5–8) — local testing defaults ──
# All default OFF in code; enabled here for local dev. See
# docs/development/agentic-local-testing.md for what each one exercises.
FEATURE_AGENT_TOOLS=true
FEATURE_VECTOR_RETRIEVAL=true
FEATURE_MCP_TOOLS=true
MCP_ENABLED_SERVERS=["msgraph","servicenow"]
MCP_USE_MOCK=true
FEATURE_AGENT_WRITE_ACTIONS=true
FEATURE_BACKGROUND_AGENTS=true
