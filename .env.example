# ==================================================
# Aditi IT Assist - Environment Configuration
# ==================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Application
APP_NAME=aditi-it-assist
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key-in-production
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aditi_assist
POSTGRES_USER=aditi
POSTGRES_PASSWORD=aditi_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Vector Store
VECTOR_STORE_TYPE=pgvector
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=Aditi IT Assist

# Observability
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aditi-it-assist

# Email (for ticket/escalation drafts)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ESCALATION_EMAIL=it-support@aditiconsulting.com
