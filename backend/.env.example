# ==================================================
# Backend — Aditi IT Assist
# ==================================================
# Copy to .env for local development.
# When running via Docker Compose, these are overridden by compose env.

# ─── App ────────────────────────────────────────
APP_NAME=aditi-it-assist
APP_ENV=development                    # development | production
DEBUG=true
LOG_LEVEL=DEBUG                        # DEBUG | INFO | WARNING | ERROR

# ─── Server ────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# ─── PostgreSQL ─────────────────────────────────
# Use "localhost" for local dev, "postgres" for Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aditi_assist
POSTGRES_USER=aditi
POSTGRES_PASSWORD=aditi_dev_password

# ─── Redis ──────────────────────────────────────
# Use "localhost" for local dev, "redis" for Docker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── LLM ────────────────────────────────────────
# Set LLM_PROVIDER=azure to use Azure AI Services (recommended for production).
# Set LLM_PROVIDER=openai to use OpenAI directly.
LLM_PROVIDER=azure                  # azure | openai | anthropic
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# OpenAI (only used when LLM_PROVIDER=openai)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-key-here

# ─── Azure AI Services ───────────────────────────
# Used when LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-azure-resource-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072           # 3072 = max for text-embedding-3-large

# ─── Vector Store ───────────────────────────────
VECTOR_STORE_TYPE=pgvector

# ─── Fluid chat (A) — natural IT-specialist conversation flow; off by default ──
# Drops forced confirm gate + one-step-at-a-time. See docs/superpowers/specs/
# 2026-07-23-fluid-grounded-chat-design.md.
FEATURE_FLUID_CHAT=false

# ─── Web research (B2) — specialist-only; off by default ──
FEATURE_WEB_RESEARCH=false
WEB_SEARCH_PROVIDER=google
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
TAVILY_API_KEY=

# ─── Email (SMTP) ───────────────────────────────
# Used by app/services/email/sender.py (SmtpEmailSender). Leave SMTP_USER /
# SMTP_PASSWORD empty for local dev — get_email_sender() returns None (inert)
# and send() raises EmailNotConfigured until both are set.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ESCALATION_EMAIL=it-support@aditiconsulting.com

# ─── Scheduled report email (C2) — off by default ──
# Reuses the SMTP_* settings above for transport.
FEATURE_SCHEDULED_REPORTS=false
REPORT_RECIPIENTS=                     # comma-separated emails, e.g. lead@aditi.com,admin@aditi.com
SCHEDULED_REPORT_DAY=1                 # day-of-month to send
SCHEDULED_REPORT_CHECK_INTERVAL_SECONDS=86400
