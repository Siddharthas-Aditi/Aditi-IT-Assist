# Backend - Aditi IT Assist
# Copy to .env and configure

APP_NAME=aditi-it-assist
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aditi_assist
POSTGRES_USER=aditi
POSTGRES_PASSWORD=aditi_dev_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

VECTOR_STORE_TYPE=pgvector
