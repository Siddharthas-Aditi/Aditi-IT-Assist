{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/claude-lint-file.sh\"",
            "timeout": 60,
            "statusMessage": "Linting changed file…"
          }
        ]
      }
    ]
  }
}
